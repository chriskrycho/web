<!DOCTYPE html>
<html lang="en">
   <head>
      <meta charset="utf-8" />

      <meta name='viewport' content='width=device-width, initial-scale=1'>

      <title>{{resolved_title(data.title, config.title)}}</title>

      <link rel="stylesheet" href="/style.css">
      <link rel="stylesheet" href="/colors/highlighting/light.css" media="(prefers-color-scheme: light)">
      <link rel="stylesheet" href="/colors/highlighting/dark.css" media="(prefers-color-scheme: dark)">

      {% block meta %}{% endblock %}

      {% block feeds %}{% endblock %}
  </head>
  <body>
      <nav>
         {% for nav_item in config.nav %}
         (nav item)
         {% endfor %}
      </nav>
      <main>
      {% block body %}
         {{ content }}
      {% endblock %}
      </main>
  </body>
</html>
